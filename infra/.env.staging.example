# -----------------------------------------------------------------------------
# Staging variables for the Coolify "Docker Compose" resource.
# Paste these into the resource's Environment Variables editor (not committed).
# `docker-compose.staging.yml` reads them; anything with a default is optional.
# -----------------------------------------------------------------------------

# --- Domains -----------------------------------------------------------------
# Subdomains under a wildcard you already point at the Coolify server.
# Coolify provisions them and issues Let's Encrypt certs automatically.
API_FQDN=api.staging.example.com
WEB_FQDN=staging.example.com
# Optional: stable Mailpit UI domain. Leave unset to let Coolify generate one.
MAILPIT_FQDN=mail.staging.example.com
# SigNoz dashboard. This IS read (by Coolify) — it publishes the `signoz`
# service on container port 8080. Full https:// URL, not a bare host.
SERVICE_FQDN_SIGNOZ_8080=https://signoz-staging-oratoria.drcode.fr
# bull-board (queue dashboard). Same deal — publishes the `bull-board` service
# on container port 3000. Leave unset to let Coolify generate a domain, or drop
# the `bull-board` service entirely for tunnel-only access.
SERVICE_FQDN_BULLBOARD_3000=https://bull-board.staging.example.com

# --- App -------------------------------------------------------------------
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_KEY=
LOG_LEVEL=info

# --- Database (container-local, private network) ----------------------------
DB_USER=coreloom_uml
DB_PASSWORD=change-me-strong
DB_DATABASE=coreloom_uml_staging

# --- Redis / job queue (container-local, private network) -------------------
# The compose file hard-codes REDIS_HOST/REDIS_PORT to the `redis` service.
# The bundled Redis has no password; only set one if you swap in a managed one.
# REDIS_PASSWORD=
# bull-board basic auth — required, the dashboard has no other gate.
BULLBOARD_USER=admin
BULLBOARD_PASSWORD=change-me-strong

# --- Mail ------------------------------------------------------------------
# Defaults target the bundled Mailpit. Point these at a real SMTP provider
# (Resend / SES / Postmark) when staging must deliver to real inboxes.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@staging.example.com
MAIL_FROM_NAME=Coreloom UML Staging

# --- Object storage (@adonisjs/drive) ------------------------------------
# There is no MinIO in the staging stack — point these at a real
# S3 / R2 / Spaces bucket. Leave DRIVE_DISK unset to default to `s3`; set it
# to `fs` only to fall back to a container-local folder (lost on redeploy).
DRIVE_DISK=s3
S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
S3_REGION=eu-west-1
S3_BUCKET=coreloom-uml-staging
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional CDN / public base URL for building public object URLs.
# S3_PUBLIC_URL=

# --- Observability (SigNoz) ----------------------------------------------
# SigNoz now runs inside this Compose stack (clickhouse / zookeeper / signoz /
# signoz-otel-collector + migrators). The `api` service already exports to
# http://signoz-otel-collector:4318 over the Compose network, so there is
# nothing to set here to turn tracing on.
#
# SIGNOZ_TOKENIZER_JWT_SECRET signs the SigNoz dashboard's own login tokens.
# The compose file reads it from ${SERVICE_PASSWORD_64_SIGNOZJWT}, which Coolify
# auto-generates and persists like SERVICE_PASSWORD_64_APPKEY — no manual entry.
# Set it explicitly only to pin a known value:
# SERVICE_PASSWORD_64_SIGNOZJWT=
