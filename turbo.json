{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".adonis/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "passThroughEnv": [
        "NODE_ENV",
        "HOST",
        "PORT",
        "APP_KEY",
        "APP_NAME",
        "LOG_LEVEL",
        "FRONTEND_URL",
        "DB_*",
        "SESSION_*",
        "LIMITER_STORE",
        "SMTP_*",
        "MAIL_*",
        "OTEL_*",
        "DRIVE_DISK",
        "S3_*",
        "REDIS_*"
      ]
    },
    "migration:run": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    }
  }
}
