# -----------------------------------------------
# Runtime environment
# -----------------------------------------------
NODE_ENV=development
HOST=localhost
PORT=3333

APP_KEY=
APP_NAME=coreloom-uml-api

# Pino log level
LOG_LEVEL=info

# -----------------------------------------------
# CORS / cookies — the web app's dev server origin.
# Both localhost and 127.0.0.1 variants are accepted automatically.
# -----------------------------------------------
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------
# PostgreSQL
# -----------------------------------------------
# Inside the dev container, use the Compose service name: DB_HOST=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=coreloom_uml_dev
# TLS defaults to on in production, off otherwise. Set DB_SSL=false when
# Postgres is only reachable on a private network without TLS (e.g. a
# Coolify-internal database); DB_SSL=true forces it on elsewhere.
# DB_SSL=
# Set DB_SSL_CA to your provider's CA certificate (PEM) if it uses a private CA.
# DB_SSL_CA=

# -----------------------------------------------
# Sessions
# -----------------------------------------------
# file   — on-disk, single instance (default)
# memory — in-process, used by the test suite
# cookie — encrypted in the client cookie; stateless, for multi-replica deploys
SESSION_DRIVER=file
# Cross-site cookie controls. Defaults: sameSite=lax, secure in production.
# When the SPA is served from a different domain than the API (e.g. a Coolify
# staging deploy), set SESSION_COOKIE_SAME_SITE=none and SESSION_COOKIE_SECURE=true.
# SESSION_COOKIE_SAME_SITE=lax
# SESSION_COOKIE_SECURE=

# -----------------------------------------------
# Rate limiter store (in-memory — no Redis needed for the MVP)
# -----------------------------------------------
LIMITER_STORE=memory

# -----------------------------------------------
# Mail (password reset, email verification)
# Local dev: Mailpit catches every email — see infra/docker-compose.yml.
# Inside the dev container, use the Compose service name: SMTP_HOST=mailpit
# Web UI: http://localhost:8025
# -----------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@coreloom-uml.dev
MAIL_FROM_NAME=Coreloom UML

# -----------------------------------------------
# Observability (OpenTelemetry → SigNoz)
# -----------------------------------------------
# All of these are read directly by instrumentation.ts / the OTel SDK, not by
# start/env.ts. Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to disable tracing
# entirely (the default for local dev, tests and CI).
#
# Self-hosted SigNoz collector:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-otel-collector:4318
# SigNoz Cloud:
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.<region>.signoz.cloud:443
#   OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=<your-key>
#
# OTEL_SERVICE_NAME=coreloom-uml-api
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=

# -----------------------------------------------
# Object storage (@adonisjs/drive)
# DRIVE_DISK picks the active disk: `fs` (local folder, no S3 needed — the
# default for tests / docker-less dev) or `s3` (S3-compatible).
# Local dev runs MinIO — see infra/docker-compose.yml. Console: http://localhost:9001
# Inside the dev container, use the Compose service name: S3_ENDPOINT=http://minio:9000
# In production, point these at a real S3 / R2 / Spaces bucket.
# -----------------------------------------------
DRIVE_DISK=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=coreloom-uml
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Optional CDN / public base URL for building public object URLs.
# S3_PUBLIC_URL=

# -----------------------------------------------
# Redis / background job queue (@adonisjs/redis + @nemoventures/adonis-jobs)
# Required — Redis is a hard dependency for the API and the `queue:work` worker.
# Local dev / CI run the `redis` container — see infra/docker-compose.yml.
# Inside the dev container, use the Compose service name: REDIS_HOST=redis
# bull-board (inspect / retry / remove jobs) Web UI: http://localhost:8082
# -----------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------
# Default account and registration
# The default account is created (or brought back in line with these values)
# by `node ace account:ensure-default`, run after the migrations. Its email and
# password can only be changed here. Required in production.
# Public sign-up stays closed unless REGISTRATION_ENABLED=true.
# -----------------------------------------------
DEFAULT_ACCOUNT_EMAIL=admin@coreloom-uml.dev
DEFAULT_ACCOUNT_PASSWORD=Default-Account-2026!
DEFAULT_ACCOUNT_NAME=Admin
REGISTRATION_ENABLED=false

# -----------------------------------------------
# Skills catalog
# `node ace skills:setup` schedules the weekly skills.sh search when
# SKILLS_REFRESH_ENABLED=true. SKILLS_GITHUB_TOKEN (a GitHub token with no
# scope) lets each run check up to 200 skills on GitHub instead of 10.
# -----------------------------------------------
SKILLS_REFRESH_ENABLED=false
SKILLS_GITHUB_TOKEN=

# -----------------------------------------------
# LLM providers (agent conventions: rule proposals)
# Users bring their own key; the server stores none. `ollama` and
# `openai-compatible` providers may only call these origins (comma-separated,
# scheme + host + port). Empty: none allowed.
# -----------------------------------------------
LLM_ALLOWED_BASE_URLS=
# Where the `claude` binary keeps each account's Claude subscription (one
# folder per user). Empty: tmp/claude in the app. A persistent volume in prod.
CLAUDE_CODE_HOME=
