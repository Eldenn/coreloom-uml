# Test-only overrides, loaded automatically by AdonisJS when NODE_ENV=test.
# Both stores need no external service; `memory` additionally lets the Japa
# test client and the app share session/rate-limit state in-process.
SESSION_DRIVER=memory
LIMITER_STORE=memory

# Tests use mail.fake() and never open a real SMTP connection, but env
# validation still runs at boot, so these need to be present.
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM_ADDRESS=no-reply@coreloom-uml.dev

# Job specs call the job's process() directly and never open a Redis connection,
# but env validation still runs at boot, so these need to be present.
REDIS_HOST=localhost
REDIS_PORT=6379
