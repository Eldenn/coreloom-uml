# Rendered to /etc/nginx/conf.d/default.conf at container start by the base
# image's `20-envsubst-on-templates.sh`. Only ${API_URL} is substituted
# (NGINX_ENVSUBST_FILTER=API_URL, set in the Dockerfile) — it must be the bare
# origin of the API, e.g. https://api.example.com, and is used to scope the
# CSP `connect-src`.

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # --- Security headers (apply to every response in this server) -----------
    # `always` so they are sent on error responses too. No add_header in the
    # location blocks below, otherwise nginx stops inheriting these.
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()" always;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self' ${API_URL}; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    # HSTS is intentionally left to the edge proxy (Coolify / Traefik) that
    # terminates TLS in front of this container.

    # Hashed Vite assets are content-addressed: cache hard. `expires` (not
    # add_header) keeps the security headers above inherited here.
    location /assets/ {
        expires 1y;
        access_log off;
        try_files $uri =404;
    }

    # Runtime config — never cache, it is rewritten per deploy.
    location = /env.js {
        expires -1;
        add_header Cache-Control "no-store" always;
    }

    # SPA fallback for client-side routes (/login, /account, ...).
    location / {
        try_files $uri /index.html;
    }
}
