{
  // The compiler options of the coreloom-ui starter (starter/tsconfig.app.json): front-end
  // settings follow coreloom-ui, so registry components type-check here as they do upstream.
  //
  // `../api/.adonisjs/client` holds the generated Tuyau registry consumed via
  // `@coreloom-uml/api/registry`. It references the API's `#app/*` source through
  // `typeof import(...)`, so type-checking `apps/web` pulls the API's `app/` into the program:
  // hence the decorator options (Lucid models) and TS-extension imports below.
  "include": ["src", "*.config.ts", "../api/.adonisjs/client/**/*"],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // The UML model and its Mermaid/PlantUML/JSON conversion live in `packages/uml`, shared with
    // the API. Registry components still import them from `@/lib/uml*`, so those paths point
    // there (keep in sync with `UML_SHARED` in vite.config.ts).
    "paths": {
      "@/lib/uml": ["../../packages/uml/src/uml.ts"],
      "@/lib/uml-elements": ["../../packages/uml/src/uml-elements.ts"],
      "@/lib/uml-text": ["../../packages/uml/src/uml-text.ts"],
      "@/lib/uml-mermaid*": ["../../packages/uml/src/uml-mermaid*.ts"],
      "@/lib/uml-plantuml*": ["../../packages/uml/src/uml-plantuml*.ts"],
      "@/*": ["./src/*"]
    }
  }
}
